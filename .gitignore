# Private vault documents — CV, Zeugnisse, anything else personal.
#
# These are uploaded straight to the Pi at /var/lib/kira1q/vault-files/, which
# is deliberately outside the web root: nginx serves /var/www and has no access
# to it, so a location-block mistake cannot expose a document.
#
# They must never enter git history either. A commit is permanent — deleting
# the file in a later commit does not remove it from the repository — and this
# remote is public, so the whole history goes with it.
#
# vault/files/ below is the retired location under the web root, from the Basic
# Auth setup. The entry stays so a leftover copy still cannot be committed.
vault/files/

# Basic Auth password files. Retired along with the shared-password setup —
# there is no .htpasswd on the Pi any more. The entries stay for the same
# reason as above: an old local copy must not become a commit.
.htpasswd
.htpasswd*
*.htpasswd

# Upload artefacts
dist-*.zip

# Local editor / tooling config. launch.json points at an absolute path on one
# machine, so it is useless to anyone else who clones this.
.claude/

# API build output and dependencies. package-lock.json IS committed — the
# image builds with `npm ci`, which needs it and refuses to run without it.
server/node_modules/
server/dist/
server/dist-test/
server/tsconfig.tsbuildinfo

# Local runtime state. On the Pi these live in /var/lib/kira1q/ and are bind
# mounted; if they ever appear here it is from running the API locally, and
# they hold password hashes and real people's IP addresses. Never commit them.
server/data/
server/vault-files/

# Publish output from running the API locally: generated pages and uploaded
# media land here in development (PAGES_DIR / MEDIA_DIR defaults). On the Pi
# they are bind mounts into the web root. Generated artefacts, never source.
server/site/
*.db
*.db-wal
*.db-shm
.env
.env.*
